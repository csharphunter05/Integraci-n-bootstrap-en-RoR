{
  "name": "app_ror",
  "private": true,
  "scripts": {
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/bootstrap.css --no-source-map --quiet-deps --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/bootstrap.css --use=autoprefixer --output=./app/assets/builds/bootstrap.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.107.1"
  }
}
